#!/bin/sh
# commit 前的驗證（用 git config core.hooksPath tools/hooks 啟用）：
#   1. 單元測試與發佈一致性測試必須全過，否則取消 commit
#   2. 官方遊戲版號必須和測試對應的版號（test/GAME_VERSION.json）一致；
#      不一致代表遊戲更新了、測試還沒跟上，取消 commit。連不上網只警告，不擋。
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "[pre-commit] 跑單元測試與發佈一致性測試…"
LOG="${TMPDIR:-/tmp}/skyfarm-pre-commit.log"
if ! node --test "test/unit/*.test.js" "test/release/*.test.js" > "$LOG" 2>&1; then
  tail -60 "$LOG"
  echo "[pre-commit] 測試沒有通過，已取消 commit。" >&2
  exit 1
fi
grep -E "^ℹ (tests|pass|fail)" "$LOG"

node tools/check-game-version.js
rc=$?
if [ "$rc" = "1" ]; then
  echo "[pre-commit] 官方遊戲已更新，請先調整測試再 commit（見 README.md 的流程）。" >&2
  exit 1
fi
exit 0
